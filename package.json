{
  "name": "phuong-nam-product-studio",
  "version": "1.2.0",
  "description": "Desktop Application for Branding & Watermarking Product Photos - Thuoc Thu Y Phuong Nam",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "predev": "node -e \"const fs = require('fs'); const path = require('path'); const p = path.join('node_modules/electron/dist', process.platform === 'win32' ? 'electron.exe' : 'Electron.app'); if (!fs.existsSync(p)) { console.log('Đang cài đặt binary Electron...'); require('child_process').execSync('node node_modules/electron/install.js', { stdio: 'inherit' }); }\" && node scripts/build-preload.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "konva": "^9.3.18",
    "lucide-react": "^0.441.0",
    "onnxruntime-node": "^1.20.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "electron",
    "watermark",
    "image-processing",
    "phuong-nam"
  ],
  "author": "Thuoc Thu Y Phuong Nam",
  "license": "MIT",
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "npm:null@^2.0.0",
    "@img/sharp-win32-x64": "^0.33.5"
  },
  "allowScripts": {
    "onnxruntime-node@1.20.1": true
  }
}
