{
  "appId": "com.phuongnam.productstudio",
  "productName": "Phương Nam Product Studio",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "Coffat",
    "repo": "Tool_Image"
  },
  "files": [
    "dist",
    "dist-electron",
    "assets",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/onnxruntime-node/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/sharp/**/*",
    "**/node_modules/@img/**/*",
    "**/node_modules/onnxruntime-node/**/*"
  ],
  "extraResources": [
    {
      "from": "models",
      "to": "models",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.photography",
    "icon": "assets/icons/icon.icns",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icons/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Phương Nam Product Studio"
  }
}
